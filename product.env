# The product this tree builds: Melee++, Melee 4K's fork with custom
# fighters (Melee 4K: github.com/rileycleavenger/melee-4k). A fork that ships
# its own game (its own releases, updates and online) changes only this file. Read by
# CMakeLists.txt, tools/package_macos.sh, tools/package_release_macos.sh,
# .github/workflows/release-windows.yml and tools/setup/setup.py; install.sh
# repeats the values it needs (it is fetched on its own).
# One KEY=value per line, no comments after a value.

# The name players see.
PRODUCT_NAME="Melee++"
# The app, its install folder and the release zips (<FILE>-macOS-arm64.zip).
PRODUCT_FILE=MeleePlusPlus
# Setup's program, the log, and this product's files in the settings folder.
PRODUCT_SLUG=meleepp
# GitHub releases: Check for Updates, and online's latest-version check.
PRODUCT_REPO=rileycleavenger/melee-plus-plus
PRODUCT_BUNDLE_ID=org.melee-pc.meleepp
PRODUCT_VERSION=1.0.0
# Custom fighter packs (docs/fighters.md): 1 loads them, 0 never does.
PRODUCT_FIGHTER_PACKS=1
